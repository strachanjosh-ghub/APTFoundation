{
  "name": "apt-foundation-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
