# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.aptfoundation.org

# Donations: raisely | stripe | none   (see docs/DONATIONS.md)
NEXT_PUBLIC_DONATION_PROVIDER=raisely
NEXT_PUBLIC_DONATION_RAISELY_BASE_URL=https://one-tomorrow.raiselysite.com

# Contact form delivery override (server-side only). Default comes from content/site.json
# (interim: FormSubmit -> Josh.Strachan@aptouring.com.au). Set when moving to Salesforce.
CONTACT_FORM_ENDPOINT=

# Optional: Google Tag Manager container for the new site
NEXT_PUBLIC_GTM_ID=

# Set to true to render draft content objects (preview environments only)
CONTENT_PREVIEW=false

# Adobe Fonts web project ID for the brand typefaces (Thermal VF, Beaufort Pro, Maison).
# Create a web project in Adobe Fonts with the APT licence and add the site's domains.
NEXT_PUBLIC_ADOBE_FONTS_KIT=
